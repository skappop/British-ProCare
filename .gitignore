# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local backup: holds the service role key and patient data
backup/backup.config.json
backup/backup.log
backup/ProCare-Backup/
ProCare-Backup/

# python bytecode
__pycache__/
*.pyc

# Dental Agent runtime files: per-PC identity, queue and logs
Dental Agent/station.json
Dental Agent/leftovers.json
Dental Agent/session_state.json
Dental Agent/agent.log*
# Each clinic PC's own settings (website address, key, export folders)
Dental Agent/config.json
Dental Agent/old versions/

# local test stack (tools/README.md)
tools/local-stack/.run/
__pycache__/
